# API Configuration
# This sets the DEFAULT backend for `npm run dev`. To switch backends without
# editing this file, use one of these instead:
#   npm run dev:local   -> http://localhost:3001 (vend88-dashboard-app/backend running locally)
#   npm run dev:remote  -> https://dbapi.vend88.com (real hosted backend)
NEXT_PUBLIC_API_BASE_URL=https://dbapi.vend88.com

# Application Settings
NEXT_PUBLIC_APP_NAME="Agent Portal"
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
