# Backend that serves /registration/validate-token and /registration/submit.
# Defaults to https://dbapi.vend88.com when unset.
#
#   local backend:  NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
#   production:     NEXT_PUBLIC_API_BASE_URL=https://dbapi.vend88.com
#
# This app is a static export (`output: 'export'`), so this value is baked in at
# build time - change it and rebuild, setting it at runtime has no effect.
NEXT_PUBLIC_API_BASE_URL=https://dbapi.vend88.com
